// Prisma schema for the CourseHub learning platform.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth.js (NextAuth v5) models: https://authjs.dev/getting-started/adapters/prisma ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String? // hashed, only set for credentials sign-in
  role          Role      @default(STUDENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  courses        Course[]         @relation("InstructorCourses")
  enrollments    Enrollment[]
  lessonProgress LessonProgress[]
  courseProgress CourseProgress[]
}

enum CourseLevel {
  Beginner
  Intermediate
  Advanced
}

enum CourseStatus {
  DRAFT
  PUBLISHED
}

enum LessonType {
  video
  test
}

enum VideoUploadStatus {
  NONE
  UPLOADING
  READY
  FAILED
}

model Course {
  id           String       @id @default(cuid())
  title        String
  slug         String       @unique
  description  String?      @db.Text
  level        CourseLevel  @default(Beginner)
  status       CourseStatus @default(DRAFT)
  priceKzt     Int          @default(0)
  thumbnailUrl String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  instructorId String
  instructor   User   @relation("InstructorCourses", fields: [instructorId], references: [id], onDelete: Cascade)

  lessons     Lesson[]
  enrollments Enrollment[]
  progress    CourseProgress[]
}

model Lesson {
  id              String     @id @default(cuid())
  title           String
  content         String?    @db.Text
  videoUrl        String?
  type            LessonType @default(video)
  durationMinutes Int        @default(0)
  isFreePreview   Boolean    @default(false)
  order           Int
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Cloudinary-backed video (see src/lib/video/). `videoUrl` above is the
  // last-saved delivery URL; playback always re-signs it from
  // `videoPublicId` via the video provider rather than trusting this value
  // directly, since Cloudinary assets are uploaded as `authenticated`.
  videoPublicId        String?
  videoDurationSeconds Int?
  videoSizeBytes       BigInt?
  videoUploadedAt      DateTime?
  videoUploadStatus    VideoUploadStatus @default(NONE)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  quiz     Quiz?
  progress LessonProgress[]
  // Reverse of CourseProgress.currentLessonId — courses currently "parked" on this lesson.
  currentForCourseProgress CourseProgress[]

  @@unique([courseId, order])
}

enum EnrollmentStatus {
  ACTIVE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

// The business layer every payment provider (Kaspi, Stripe, ...) plugs into:
// a provider confirms payment on its own, then calls createEnrollment
// (src/lib/actions/enrollment.ts) — this model and its access rules don't
// change per provider, only paymentProvider/paymentReference do.
model Enrollment {
  id               String           @id @default(cuid())
  userId           String
  courseId         String
  enrolledAt       DateTime         @default(now())
  status           EnrollmentStatus @default(ACTIVE)
  paymentStatus    PaymentStatus    @default(PENDING)
  paymentProvider  String           @default("manual")
  paymentReference String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Quiz {
  id            String   @id @default(cuid())
  lessonId      String   @unique
  title         String
  passingScore  Int      @default(50)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lesson    Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions Question[]
}

model Question {
  id     String @id @default(cuid())
  quizId String
  text   String
  order  Int

  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@unique([quizId, order])
}

model Answer {
  id         String  @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean @default(false)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

// Per (user, lesson) record of quiz completion. Written only from
// markLessonCompleted (src/lib/actions/progress.ts) after a quiz submission
// — never revoked once completed=true, and score/percentage always keep the
// highest value ever achieved, even across failed retries.
model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  completed   Boolean   @default(false)
  score       Int?
  percentage  Int?
  attempts    Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

// Per (user, course) cache of "the furthest lesson reached." This is a
// denormalized, advance-only pointer recomputed from LessonProgress by
// unlockNextLesson — the source of truth for *whether* a lesson is passed
// is always LessonProgress; this just avoids re-walking every lesson on
// every page load.
model CourseProgress {
  id              String   @id @default(cuid())
  userId          String
  courseId        String
  currentLessonId String?
  lastActivityAt  DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course        Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  currentLesson Lesson? @relation(fields: [currentLessonId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
}
